NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=FarahEvent

# 1 = sert la fixture src/mocks/event-config.fixture.ts au lieu de l'API
# (développement des templates sans backend)
NEXT_PUBLIC_USE_MOCK=1

# Clé site Cloudflare Turnstile (tunnel d'achat). Vide = champ masqué en dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret partagé avec le backend pour l'invalidation ISR (POST /api/revalidate)
REVALIDATE_SECRET=change-me

# Origine API vue par le BFF (serveur Next) si différente de NEXT_PUBLIC_API_URL
# (ex. réseau interne). Optionnel — défaut : NEXT_PUBLIC_API_URL.
# ADMIN_API_URL=http://backend:8000/api/v1
