# App
APP_ENV=development
DEBUG=True
SECRET_KEY=change-this-secret-key-minimum-32-characters
# Clé dédiée à la signature des billets (QR + live) — DISTINCTE de SECRET_KEY en prod (≥32 car.)
TICKET_SIGNING_KEY=change-this-ticket-signing-key-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database PostgreSQL (async + sync pour Alembic)
DATABASE_URL=postgresql+asyncpg://farahevent_user:password@localhost:5432/farahevent
DATABASE_URL_SYNC=postgresql+psycopg2://farahevent_user:password@localhost:5432/farahevent

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","https://farahevent.tech"]

# GeniusPay — paiement digital (mobile money + carte CI).
# Tableau de bord : onglet Sandbox / Production — les clés ET le secret de webhook
# DIFFÈRENT entre les deux. Sans API_KEY+SECRET_KEY, le stub prend le relais et
# aucun paiement digital n'est encaissé (un WARNING le signale au boot).
# ⚠ Éditer ce fichier en UTF-8 (VS Code / Notepad++). PowerShell Add-Content /
#   Out-File écrit en UTF-16 et le backend refuse alors de démarrer.
GENIUSPAY_API_KEY=            # pk_sandbox_… / pk_live_…
GENIUSPAY_SECRET_KEY=         # sk_sandbox_… / sk_live_… — jamais côté client
GENIUSPAY_WEBHOOK_SECRET=     # whsec_… — distinct par environnement ; vide = webhooks rejetés
GENIUSPAY_MODE=test           # test / live
GENIUSPAY_API_URL=https://geniuspay.ci/api/v1/merchant

# OpenWA / WhatsApp
OPENWA_API_URL=http://localhost:3001
OPENWA_API_KEY=your_openwa_api_key
WHATSAPP_SENDER=farahevent

# Cloudflare Turnstile (anti-bot achat) — laisser vide en dev pour désactiver la vérif serveur
TURNSTILE_SECRET_KEY=

# Brevo (email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=billetterie@farahevent.tech
BREVO_SENDER_NAME=FarahEvent

# URLs
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000/api/v1
QR_CODE_BASE_URL=http://localhost:3000/verify

# Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
